[
    {
        "id": "NO_RAW_CSV_IN_TESTS",
        "pattern": "pd\\.read_csv\\(",
        "include": [
            "tests/**/*.py",
            "formats/**/tests/**/*.py"
        ],
        "exclude": [
            "core/data_loader.py",
            "scripts/**/*.py",
            "tools/**/*.py"
        ],
        "message": "❌ VIOLATION: Never load raw CSVs in tests. Use `CricketAnalyzer(filepath)` (Facade) to ensure environment parity.",
        "severity": "CRITICAL"
    },
    {
        "id": "NO_HARDCODED_COLORS",
        "pattern": "['\"]#[0-9a-fA-F]{6}['\"]",
        "include": [
            "**/*.py"
        ],
        "exclude": [
            "config/shared/team_colors.py",
            "scripts/**/*.py"
        ],
        "message": "🎨 VIOLATION: Do not hardcode Hex Colors. Use `config.shared.team_colors.TEAM_COLORS`.",
        "severity": "WARNING"
    },
    {
        "id": "NO_PRINT_IN_ENGINES",
        "pattern": "print\\(",
        "include": [
            "core/**/*.py",
            "formats/**/engine.py",
            "formats/**/predictor.py"
        ],
        "exclude": [
            "scripts/**/*.py",
            "tests/**/*.py"
        ],
        "message": "🔇 VIOLATION: Do not use `print()` in Core Engines. Use `logging` or return data for the UI to display.",
        "severity": "WARNING"
    },
    {
        "id": "SAFE_DATETIME_LOOKBACK",
        "pattern": "pd\\.Timestamp\\.now\\(\\)\\s*-\\s*",
        "include": [
            "**/*.py"
        ],
        "exclude": [],
        "message": "📅 VIOLATION: Unsafe Date Math. Use `pd.Timestamp.now().floor('D')` to include the full boundary day.",
        "severity": "CRITICAL"
    },
    {
        "id": "API_FIRST_NO_HTML_RETURN",
        "pattern": "return\\s+.*<div.*>",
        "include": [
            "core/**/*.py",
            "formats/**/engine.py",
            "formats/**/predictor.py"
        ],
        "exclude": [
            "formats/**/renderers/*.py"
        ],
        "message": "🏗️ VIOLATION: Engines must be HEADLESS. Do not return HTML strings. Return Dicts or DataFrames.",
        "severity": "CRITICAL"
    },
    {
        "id": "VECTORIZATION_MANDATE",
        "pattern": "\\.iterrows\\(\\)",
        "include": [
            "core/**/*.py",
            "formats/**/engine.py",
            "formats/**/predictor.py"
        ],
        "exclude": [],
        "message": "⚡ VIOLATION: Vectorization Mandate. Do not use `.iterrows()`. Use vectorized pandas operations.",
        "severity": "CRITICAL"
    },
    {
        "id": "CRASH_LOUD_NO_SILENT_PASS",
        "pattern": "except\\s+Exception:\\s*pass",
        "include": [
            "**/*.py"
        ],
        "exclude": [
            "scripts/**/*.py"
        ],
        "message": "💥 VIOLATION: Crash Early, Crash Loud. Do not swallow exceptions with `pass`. Log it or raise specific errors.",
        "severity": "WARNING"
    },
    {
        "id": "TYPED_TRUTH_MANDATE",
        "pattern": "def\\s+\\w+\\(.*\\):",
        "include": [
            "core/**/*.py",
            "formats/**/engine.py",
            "formats/**/predictor.py"
        ],
        "exclude": [
            "tests/**/*.py",
            "scripts/**/*.py"
        ],
        "message": "📝 VIOLATION: Missing Type Hints. Every function signature must have explicit type hints (e.g. `-> pd.DataFrame`).",
        "severity": "WARNING"
    },
    {
        "id": "LEAVE_NO_TRACE",
        "pattern": ".",
        "include": [
            "**/debug_*.py",
            "**/temp_*.py",
            "**/fix_*.py",
            "**/*.log"
        ],
        "exclude": [],
        "message": "🧹 VIOLATION: Leave No Trace. Temporary debug scripts and log files must be deleted before committing.",
        "severity": "CRITICAL"
    },
    {
        "id": "BARE_EXCEPT_BLOCK",
        "pattern": "except\\s*:",
        "include": [
            "**/*.py"
        ],
        "exclude": [
            "scripts/**/*.py"
        ],
        "message": "💥 VIOLATION: Bare `except:` is forbidden. Always catch specific exceptions (KeyError, ValueError, etc.). See docs/ai/GEMINI.md §2.4.",
        "severity": "CRITICAL"
    },
    {
        "id": "NO_IPYTHON_IN_CORE",
        "pattern": "from\\s+IPython|import\\s+IPython",
        "include": [
            "core/**/*.py",
            "formats/**/engines/**/*.py",
            "formats/**/predictor.py"
        ],
        "exclude": [],
        "message": "🚫 VIOLATION: IPython imports forbidden in core/engine files. Engines must be API-safe. IPython only in interface.py.",
        "severity": "CRITICAL"
    },
    {
        "id": "NO_FORMAT_HARDCODE_IN_CORE",
        "pattern": "from\\s+formats\\.odi",
        "include": [
            "core/**/*.py"
        ],
        "exclude": [
            "core/team_engine.py",
            "core/player_engine.py",
            "core/predictor.py"
        ],
        "message": "🏗️ VIOLATION: Core modules must not import format-specific code directly. Use config.format_registry for dynamic loading.",
        "severity": "CRITICAL"
    }
]