#!/bin/bash
# Cricket Algo-Trading Platform — pre-commit gate sequence
# Gates run in order. Any FAIL blocks the commit.
# Dormant gates are commented out — activate when their phase ships.

STAGED=$(git diff --cached --name-only)

# ── SCOPE GUARD ─────────────────────────────────────────────────────────
# Active during Codex tasks only (scope.json present). Human commits always pass.
SCOPE_FILE="agents/workflow/scope.json"
if [ -f "$SCOPE_FILE" ]; then
    ALLOWED=$(python -c "
import json
with open('$SCOPE_FILE') as f:
    data = json.load(f)
for p in data.get('allowed_files', []):
    print(p)
")
    VIOLATIONS=()
    while IFS= read -r file; do
        if [ -z "$file" ]; then continue; fi
        FOUND=false
        while IFS= read -r allowed; do
            if [ "$file" = "$allowed" ]; then
                FOUND=true
                break
            fi
        done <<< "$ALLOWED"
        if [ "$FOUND" = false ]; then
            VIOLATIONS+=("$file")
        fi
    done <<< "$STAGED"

    FINAL_VIOLATIONS=()
    for v in "${VIOLATIONS[@]}"; do
        # Always allow workflow files (pipeline state) and contract files (assertion graduates)
        if [[ "$v" != agents/workflow/* ]] && [[ "$v" != tests/contracts/* ]]; then
            FINAL_VIOLATIONS+=("$v")
        fi
    done

    if [ ${#FINAL_VIOLATIONS[@]} -gt 0 ]; then
        echo ""
        echo "SCOPE GUARD — COMMIT REJECTED"
        echo "The following files are not in agents/workflow/scope.json:"
        for v in "${FINAL_VIOLATIONS[@]}"; do
            echo "  - $v"
        done
        echo ""
        echo "If scope needs to expand: Claude updates scope.json and re-authorises."
        TASK_ID=$(python -c "import json; d=json.load(open('$SCOPE_FILE')); print(d.get('task_id','unknown'))")
        echo "Task ID: $TASK_ID"
        echo ""
        exit 1
    fi
fi

# ── GATE 1 — boundary-sentinel ─────────────────────────────────────────
# Trigger: any core/ file staged
if echo "$STAGED" | grep -q "core/"; then
    echo "GATE 1 — boundary-sentinel: TRIGGERED"
    python core/gen_ai/skills/validators/backend/boundary-sentinel/scripts/run_sentinel.py --root .
    if [ $? -ne 0 ]; then
        echo "GATE 1 FAILED — boundary violation. Commit blocked."
        exit 1
    fi
    echo "GATE 1 — PASS"
fi

# ── GATE C — contract-regression ───────────────────────────────────────
# Trigger: any core/calculators/, core/services/, or formats/*/engines/ file staged
if echo "$STAGED" | grep -qE "core/calculators/|core/services/|formats/.*engines/"; then
    if [ -d "tests/contracts" ] && [ "$(find tests/contracts -maxdepth 1 -name '*.py' | head -1)" ]; then
        echo "GATE C — contract-regression: TRIGGERED"
        python -m pytest tests/contracts/ -x -q --tb=short
        if [ $? -ne 0 ]; then
            echo "GATE C FAILED — contract regression detected. Commit blocked."
            echo "  Intentional change: update the contract file and include it in FILES IN SCOPE."
            echo "  Unintentional change: the implementation introduced a regression. Fix it."
            exit 1
        fi
        echo "GATE C — PASS"
    else
        echo "GATE C — no contracts yet, SKIPPED"
    fi
fi

# ── GATE 2 — duckdb-lint-ops ───────────────────────────────────────────
# Trigger: any calculators/ engines/ services/ file staged
if echo "$STAGED" | grep -qE "calculators/|engines/|services/"; then
    echo "GATE 2 — duckdb-lint-ops: TRIGGERED"
    python core/gen_ai/skills/guides/backend/duckdb-lint-ops/scripts/run_lint.py --root .
    if [ $? -ne 0 ]; then
        echo "GATE 2 FAILED — DuckDB lint violation. Commit blocked."
        exit 1
    fi
    echo "GATE 2 — PASS"
fi

# ── GATE 3 — manifest-contract-verifier ────────────────────────────────
# Trigger: any manifest or engines/ file staged
if echo "$STAGED" | grep -qE "manifest|engines/"; then
    echo "GATE 3 — manifest-contract-verifier: TRIGGERED"
    GATE3_FAIL=0
    for manifest in $(find formats -name "manifest.py" 2>/dev/null); do
        python core/gen_ai/skills/validators/backend/manifest-contract-verifier/scripts/run_verifier.py --root . --manifest "$manifest"
        if [ $? -ne 0 ]; then
            GATE3_FAIL=1
        fi
    done
    if [ $GATE3_FAIL -ne 0 ]; then
        echo "GATE 3 FAILED — manifest contract violation. Commit blocked."
        exit 1
    fi
    echo "GATE 3 — PASS"
fi

# ── GATE 4 — serialization-guard ───────────────────────────────────────
# Trigger: any serializers or schemas/ file staged
if echo "$STAGED" | grep -qE "serializers|schemas/"; then
    echo "GATE 4 — serialization-guard: TRIGGERED"
    python core/gen_ai/skills/validators/backend/serialization-guard/scripts/run_lint.py --root .
    if [ $? -ne 0 ]; then
        echo "GATE 4 FAILED — serialization violation. Commit blocked."
        exit 1
    fi
    echo "GATE 4 — PASS"
fi

# ── GATE 5S — semgrep-security ─────────────────────────────────────────
# Trigger: any core/, api/, or formats/ Python file staged
# Authoritative check is Codex's semgrep MCP. This is the hook-time enforcement layer.
# Skipped gracefully if semgrep CLI is not installed.
STAGED_PYTHON_BACKEND=$(echo "$STAGED" | grep -E "^(core|api|formats)/.*\.py$")
if [ -n "$STAGED_PYTHON_BACKEND" ]; then
    if command -v semgrep >/dev/null 2>&1; then
        echo "GATE 5S — semgrep-security: TRIGGERED"
        semgrep --config=auto --error --quiet $STAGED_PYTHON_BACKEND
        if [ $? -ne 0 ]; then
            echo "GATE 5S FAILED — security violation. Commit blocked."
            exit 1
        fi
        echo "GATE 5S — PASS"
    else
        echo "GATE 5S — semgrep CLI not found, SKIPPED (Codex MCP check still applies)"
    fi
fi

# ── GATE 5T — python-type-check ────────────────────────────────────────
# Trigger: any Python file staged
# Skipped gracefully if ruff/mypy not installed (python_type_check.py handles this).
if echo "$STAGED" | grep -q "\.py$"; then
    echo "GATE 5T — python-type-check: TRIGGERED"
    python core/utils/python_type_check.py --root .
    if [ $? -ne 0 ]; then
        echo "GATE 5T FAILED — ruff/mypy violation. Commit blocked."
        exit 1
    fi
    echo "GATE 5T — PASS"
fi

# ── GATE F1 — frontend-lint-sentinel ───────────────────────────────────
# Trigger: any frontend/ .tsx, .ts, or .css file staged
# Scans ONLY staged files — not the full frontend directory.
STAGED_FRONTEND=$(echo "$STAGED" | grep -E "frontend/.*\.(tsx|ts|css)$")
if [ -n "$STAGED_FRONTEND" ]; then
    echo "GATE F1 — frontend-lint-sentinel: TRIGGERED"
    python core/gen_ai/skills/validators/frontend/frontend-lint-sentinel/scripts/run_frontend_lint.py --root . --files $STAGED_FRONTEND
    if [ $? -ne 0 ]; then
        echo "GATE F1 FAILED — frontend lint violation. Commit blocked."
        exit 1
    fi
    echo "GATE F1 — PASS"
fi

# ── SRP CHECK — Single Responsibility Principle guard ─────────────────
# Trigger: any frontend/components/ .tsx file staged
# Rule: every file, function, and class must have a single responsibility.
#       Files over 300 lines are a signal of SRP violation — not because
#       line count is the rule, but because a file that long almost certainly
#       does more than one thing. (TACTICAL_EXECUTION.md §4)
STAGED_COMPONENTS=$(echo "$STAGED" | grep -E "frontend/components/.*\.tsx$")
if [ -n "$STAGED_COMPONENTS" ]; then
    SRP_FAIL=0
    for f in $STAGED_COMPONENTS; do
        if [ -f "$f" ]; then
            LINES=$(wc -l < "$f")
            if [ "$LINES" -gt 300 ]; then
                echo "[SRP VIOLATION] $f: $LINES lines"
                echo "  300 lines is a signal, not the goal. Required action:"
                echo "  1. List every distinct responsibility this file holds"
                echo "  2. Extract each into a dedicated file with clean prop interfaces"
                echo "  3. Apply the 'describe without and' test to every resulting file"
                echo "  Merely moving lines to stay under 300 is a Hard Fail."
                SRP_FAIL=1
            fi
        fi
    done
    if [ "$SRP_FAIL" -ne 0 ]; then
        echo "SRP CHECK FAILED — perform structural SRP analysis. Commit blocked."
        exit 1
    fi
    echo "SRP CHECK — PASS"
fi

# ── GATE F2 — frontend-paradigm-sentinel ───────────────────────────────
# Trigger: any frontend/ .tsx or .ts file staged
# Scans ONLY staged files — not the full frontend directory.
STAGED_FRONTEND_TS=$(echo "$STAGED" | grep -E "frontend/.*\.(tsx|ts)$")
if [ -n "$STAGED_FRONTEND_TS" ]; then
    echo "GATE F2 — frontend-paradigm-sentinel: TRIGGERED"
    python core/gen_ai/skills/validators/frontend/frontend-paradigm-sentinel/scripts/run_frontend_paradigm.py --root . --files $STAGED_FRONTEND_TS
    if [ $? -ne 0 ]; then
        echo "GATE F2 FAILED — frontend paradigm violation. Commit blocked."
        exit 1
    fi
    echo "GATE F2 — PASS"
fi

# ── GATE F3 — frontend-type-sync-guard ─────────────────────────────────
# Trigger: any frontend/ file staged
if echo "$STAGED" | grep -q "frontend/"; then
    echo "GATE F3 — frontend-type-sync-guard: TRIGGERED"
    python core/gen_ai/skills/validators/frontend/frontend-type-sync-guard/scripts/run_type_sync.py --root .
    if [ $? -ne 0 ]; then
        echo "GATE F3 FAILED — type sync violation. Commit blocked."
        exit 1
    fi
    echo "GATE F3 — PASS"
fi

# ── GATE 5P — paradigm-sentinel (meta-gate, always runs) ───────────────
echo "GATE 5P — paradigm-sentinel: TRIGGERED (always-on)"
python core/utils/paradigm_sentinel.py --root .
if [ $? -ne 0 ]; then
    echo "GATE 5P FAILED — combined paradigm violation. Commit blocked."
    exit 1
fi
echo "GATE 5P — PASS"

# ── GATE 6 — compliance_bouncer (always runs) ──────────────────────────
echo "GATE 6 — compliance_bouncer: TRIGGERED (always-on)"
python core/utils/compliance_bouncer.py --root .
if [ $? -ne 0 ]; then
    echo "GATE 6 FAILED — compliance violation. Commit blocked."
    exit 1
fi
echo "GATE 6 — PASS"

