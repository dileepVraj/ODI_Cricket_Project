# ==============================================
# Cricket Algo-Trader — Environment Configuration
# ==============================================
# Copy this file as .env and fill in your values.
# NEVER commit .env to version control.

# --- Data Paths ---
# DEFAULT_FORMAT=odi
# ODI_DATA_DIR=formats/odi/data

# --- API Server (Phase 1+) ---
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=true

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s %(name)s %(levelname)s %(message)s

# --- DuckDB ---
# DUCKDB_READ_ONLY=true
